{
  "name": "@emberbox/ui",
  "version": "0.1.0",
  "description": "Gemeinsamer Stil und gemeinsame Bausteine der Emberbox-Werkzeuge, auf Basis von Nuxt UI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rainbowdashlabs/emberbox.git",
    "directory": "packages/ui"
  },
  "files": [
    "src",
    "dist",
    "logos"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./vorrendern": "./src/vorrendern.ts",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./stil.css": "./src/stil.css",
    "./logos/*": "./logos/*"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.vite.json",
    "typecheck": "vue-tsc -b",
    "icons": "node scripts/icons-pruefen.mjs",
    "logos": "node scripts/logos-bauen.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.159",
    "@iconify/vue": "^5.0.5",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.13.1",
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^14.4.0",
    "defu": "^6.1.7",
    "tailwindcss": "^4.3.5",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
